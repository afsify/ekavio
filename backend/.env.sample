NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/ekavio
DATABASE_URL=postgresql://ekavio:ekavio-local-development-only@localhost:5432/ekavio
JWT_SECRET=replace-with-a-long-development-secret
REFRESH_TOKEN_SECRET=replace-with-another-long-development-secret
HTTP_ALLOWED_ORIGINS=http://localhost:5173
SOCKET_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0

